# Backend Environment Variables
# Copy to .env and fill in values

# Application
APP_NAME=GEOSIX API
APP_VERSION=0.1.0
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (for future PostgreSQL/PostGIS integration)
# DATABASE_URL=postgresql://user:password@localhost:5432/geosix
