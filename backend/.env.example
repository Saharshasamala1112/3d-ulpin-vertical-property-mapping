# GEOSIX backend environment variables
#
# This is a template, not a configuration file. Copy it and edit the copy:
#
#     cp .env.example .env
#
# Every value below is an EXAMPLE. There are no real secrets in this file, and
# nothing here should ever be reused outside local development. In particular the
# development JWT secret is refused by the application whenever DEBUG=false --
# see "PRODUCTION CHANGES" below.
#
# ---------------------------------------------------------------------------
# THIS FILE IS FOR RUNNING THE APP FROM A CHECKOUT. IT IS NOT USED IN CONTAINERS.
# ---------------------------------------------------------------------------
#
# `.env` is read by pydantic-settings, so it configures `uvicorn app.main:app
# --reload` and `alembic` on your machine. It is never copied into either Docker
# image (see backend/.dockerignore), and the containers take their configuration
# from the process environment instead: docker-compose.yml interpolates every
# variable below into the backend service.
#
# For the containerized stack, copy the ROOT .env.example instead:
#
#     cp .env.example .env
#
# The root .env.example holds the same variables plus the published host ports, and
# is the file `docker compose` reads. See docs/deployment.md.

# ---------------------------------------------------------------------------
# DEVELOPMENT (the values as shipped work for a local `uvicorn app.main:app`)
# ---------------------------------------------------------------------------

# Application
APP_NAME=GEOSIX API
APP_VERSION=0.1.0

# Debug mode. Leave true for local development. In debug mode the JWT secret may
# be left unset and the app falls back to the development-only value below.
DEBUG=true

# API prefix. Declared in app/core/config.py and documented in docs/deployment.md.
# The routers in app/main.py currently register their prefixes explicitly, so this
# is informational rather than the single source of truth for routing.
API_V1_PREFIX=/api/v1

# CORS -- JSON list of allowed browser origins. 5173 is the Vite dev-server port,
# which is what `npm run dev` serves on. Under Docker Compose the frontend is
# published on 8080 instead, so the containerized stack uses that origin (see the
# root .env.example). Never set a wildcard, and never point this at a Docker service
# name: `backend` only resolves inside the Compose network.
CORS_ORIGINS=["http://localhost:5173"]

# JWT authentication
#
# DEVELOPMENT SECRET -- DO NOT USE IN PRODUCTION.
# This exact value is rejected when DEBUG=false. It exists only so a developer
# can start the app without inventing a secret. Generate your own instead:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=geosix-insecure-development-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database -- local development database.
DATABASE_URL=postgresql+psycopg://geosix:geosix_password@localhost:5432/geosix_dev

# Database used by the integration test suite. Point it at a throwaway database
# that is reset per session; it must never be a database holding real data.
# Not read by app.core.config -- only backend/tests/integration/conftest.py.
TEST_DATABASE_URL=postgresql+psycopg://geosix:geosix_password@localhost:5432/geosix_test

# bcrypt cost factor. Leave at 12 in production; the test suite lowers it to keep
# runs fast. Lowering it in production weakens password hashing.
BCRYPT_ROUNDS=12

# Login throttling. State is persisted in the login_attempts database table.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password reset and email delivery. Without SMTP_HOST, reset email delivery is
# disabled; the API still returns its generic anti-enumeration response.
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@geosix.local
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# PRODUCTION CHANGES
# ---------------------------------------------------------------------------
#
# The app refuses to start in non-debug mode (DEBUG=false) when JWT_SECRET_KEY is
# missing, empty, a known placeholder such as the value above, or shorter than 32
# characters. It fails while Settings is being constructed, so it fails before
# any database connection or request handling.
#
# For a production deployment, set all of:
#
#   DEBUG=false
#   JWT_SECRET_KEY=<unique, >= 32 characters, generated per environment>
#   DATABASE_URL=<production connection string, injected as a secret>
#   TEST_DATABASE_URL=<a disposable test database, or left unset in prod images>
#   CORS_ORIGINS=["https://your-frontend.example.com"]
#   SMTP_HOST=<your SMTP server>
#   SMTP_USER=<SMTP username, if required>
#   SMTP_PASSWORD=<SMTP password, if required; inject as a secret>
#
# JWT_SECRET_KEY must differ between development, staging and production, and
# must be supplied through your secret manager -- not committed to the repository.
