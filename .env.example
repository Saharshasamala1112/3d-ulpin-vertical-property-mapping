# =============================================================================
# Root environment template for Docker Compose.
#
#     cp .env.example .env
#
# This is a template, not a configuration file. There are no real secrets here and
# nothing below should be reused outside local development. Compose reads this file
# for variable interpolation; it is never copied into an image.
#
# The defaults are the repository's documented local-development values, so
# `docker compose up --build` works with no setup at all. The backend additionally
# refuses to start with DEBUG=false if JWT_SECRET_KEY is still the development value
# (see backend/.env.example and docs/deployment.md).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16 + PostGIS 3.4)
# -----------------------------------------------------------------------------
# POSTGRES_DB/USER/PASSWORD feed both the postgres container's own POSTGRES_*
# variables and the backend's DATABASE_URL, which docker-compose.yml assembles and
# points at the `postgres` service name -- not localhost, which inside the backend
# container is the backend container itself.
#
# POSTGRES_PORT is where the container publishes on the host. It is bound to
# 127.0.0.1 only, so the database is not reachable from the network.
POSTGRES_DB=geosix_dev
POSTGRES_USER=geosix
POSTGRES_PASSWORD=geosix_password
POSTGRES_PORT=5432

# Hostname to use from *outside* Compose, e.g. when running the backend directly
# with `uvicorn` against the containerised database. Not read by docker-compose.yml.
POSTGRES_HOST=localhost

# -----------------------------------------------------------------------------
# Published host ports
# -----------------------------------------------------------------------------
# BACKEND_PORT is bound to 127.0.0.1 too, and exists for local debugging only:
# the browser reaches the API through the frontend nginx, not through this port.
BACKEND_PORT=8000

# FRONTEND_PORT defaults to 8080, not 5173, because 5173 is the Vite dev-server
# port: binding the container there would make `npm run dev` and the containerized
# frontend mutually exclusive. Set FRONTEND_PORT=5173 if you prefer.
FRONTEND_PORT=8080

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=GEOSIX API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# DEBUG=false in production. When false, Settings requires a real JWT_SECRET_KEY and
# rejects the development value below, so flipping this flag alone cannot ship a
# development secret.
DEBUG=true

# The browser-facing frontend origin, never a Docker service name. `backend` resolves
# only inside the Compose network, so the browser must never be pointed at it.
CORS_ORIGINS=["http://localhost:8080"]

# Base URL used to build password-reset links in emails.
FRONTEND_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# JWT authentication
# -----------------------------------------------------------------------------
# DEVELOPMENT SECRET -- DO NOT USE IN PRODUCTION.
# Settings rejects this exact value when DEBUG=false. Generate your own instead:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=geosix-insecure-development-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# bcrypt cost factor. Keep 12 in production; lowering it weakens password hashing.
BCRYPT_ROUNDS=12

# Login throttling, persisted in the login_attempts table.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password reset and email delivery.
PASSWORD_RESET_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# SMTP (password reset email delivery)
# -----------------------------------------------------------------------------
# An empty SMTP_HOST disables dispatch: the endpoint still returns its generic
# anti-enumeration response and logs that delivery is disabled. That means password
# recovery does not work until SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@geosix.local
SMTP_STARTTLS=true

# =============================================================================
# PRODUCTION CHANGES
# =============================================================================
# For a real deployment, set at least:
#
#   DEBUG=false
#   JWT_SECRET_KEY=<unique per environment, at least 32 characters>
#   POSTGRES_PASSWORD=<strong, generated>
#   CORS_ORIGINS=["https://your-frontend.example.com"]
#   FRONTEND_BASE_URL=https://your-frontend.example.com
#   SMTP_HOST=<your SMTP server>          # or accept that password reset is disabled
#
# Inject these from a secret manager rather than writing them into .env on a shared
# host. JWT_SECRET_KEY must differ between development, staging and production, and
# rotating it invalidates every already-issued token.
#
# See docs/deployment.md for the full checklist, backup/restore, and troubleshooting.
# =============================================================================